{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch-path=src src/index.ts",
    "start": "NODE_ENV=production node src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@simplewebauthn/browser": "^14.0.0",
    "remix": "3.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@remix-run/test": {
      "esbuild": "0.28.2"
    },
    "minimatch@>=7 <11": "11.0.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs": false
  }
}
