{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development nodemon",
    "start": "NODE_ENV=production node --import remix/node-tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@simplewebauthn/browser": "^14.0.0",
    "remix": "3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@remix-run/test": {
      "esbuild": "0.28.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs": false
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,tsx,css",
    "legacyWatch": true,
    "signal": "SIGTERM",
    "exec": "node --import remix/node-tsx src/index.ts"
  }
}
