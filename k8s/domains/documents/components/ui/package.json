{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild app/platform/observability/otel.ts --bundle --platform=node --format=esm --outfile=dist/otel.js --packages=external && esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
    "dev": "tsx --watch server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/instrumentation-undici": "^0.30.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "remix": "^3.0.0-beta.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
