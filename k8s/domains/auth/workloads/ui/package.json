{
  "name": "auth-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx src/server.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx src/server.ts",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@simplewebauthn/browser": "^14.0.0",
    "remix": "^3.0.0-rc.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@remix-run/test": {
      "esbuild": "0.28.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs": false
  }
}
